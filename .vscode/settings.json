{
  // Use the uv-managed virtual environment rather than a system Python.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Test discovery for the built-in Testing panel. No extra extension needed.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Pylance defaults to a laxer mode than the pyright CLI; "standard" makes the
  // editor agree with what a command-line run reports.
  "python.analysis.typeCheckingMode": "standard",

  // Ruff owns formatting and import sorting, reading [tool.ruff] from
  // pyproject.toml, so the editor and CI cannot disagree.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    },
    // Matches line-length in pyproject.toml.
    "editor.rulers": [88]
  },

  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },

  // Generated directories, hidden from the file tree.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  }
}
